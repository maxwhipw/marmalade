{
  "name": "@marmalade/cli",
  "version": "0.0.1",
  "description": "marmalade — interactive terminal client for the marmaladed gateway",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "marmalade": "dist/index.js"
  },
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "node --test --experimental-strip-types \"test/*.test.ts\""
  },
  "dependencies": {
    "@marmalade/daemon": "workspace:*",
    "@marmalade/protocol": "workspace:*",
    "@marmalade/ui-tree": "workspace:*",
    "qrcode-terminal": "0.12.0"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "typescript": "5.9.3"
  }
}
